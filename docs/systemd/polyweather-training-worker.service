[Unit]
Description=PolyWeatherBot managed training worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/john/Work/PolyWeatherBot
ExecStart=/home/john/Work/PolyWeatherBot/.venv/bin/python -m scripts.training_worker --catalog runs/_management/training_catalog.db --gpu-lock runs/_management/training.gpu.lock --optuna-storage sqlite:///runs/_management/optuna.db
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
